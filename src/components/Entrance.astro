
---
---

<main class="entrance">
  <div class="blurred-background" aria-hidden="true">
    <img
      src={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/images/entrance.webp`}
      alt=""
      draggable="false"
    />
  </div>

  <div class="scene">
    <img
      class="library-image"
      src={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/images/entrance.webp`}
      alt="An antique library filled with books"
    />

<div class="edge-shimmer"></div>

<div class="top-title">

<svg class="title-book-icon" viewBox="0 0 64 64" fill="none">
  <path
    d="M32 17C24 10 13 11 6 14V49C15 46 24 47 32 54C40 47 49 46 58 49V14C51 11 40 10 32 17Z"
    fill="#D5B77C"
    fill-opacity="0.22"
    stroke="#FFE3AD"
    stroke-width="2.5"
    stroke-linejoin="round"
  />
  <path
    d="M32 17V54"
    stroke="#FFE3AD"
    stroke-width="2.5"
    stroke-linecap="round"
  />
  <path
    d="M13 21C19 20 24 22 28 25M36 25C40 22 45 20 51 21"
    stroke="#FFE3AD"
    stroke-width="2"
    stroke-linecap="round"
  />
</svg>

  <h1>POPO'S LIBRARY</h1>
  <span>OPEN THE BOOK</span>
</div>


    <button
      class="highlight-book"
      id="archiveBook"
      aria-label="Open the archive"
      type="button"
    >
    </button>

    <svg class="book-outline" viewBox="0 0 100 100" preserveAspectRatio="none">
      <path d="
        M 3,16.5
        Q 0,16 1,19
        L 53,96
        Q 55,100 58,100
        L 69,100
        Q 73,100 74,96
        L 99,29
        Q 101,25 97,24
        L 4,16
        Q 3,16 3,16.5
        Z
      " />
    </svg>
    <svg class="book-ripple" viewBox="0 0 100 100" preserveAspectRatio="none">
  <path d="
    M 3,16.5
    Q 0,16 1,19
    L 53,96
    Q 55,100 58,100
    L 69,100
    Q 73,100 74,96
    L 99,29
    Q 101,25 97,24
    L 4,16
    Q 3,16 3,16.5
    Z
  " />
</svg>

<div class="book-hint">
  <svg viewBox="0 0 36 16" class="hint-arrow">
    <path
      d="M34 8H3M3 8L10 2M3 8L10 14"
      fill="none"
      stroke="currentColor"
      stroke-width="1.4"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
  </svg>
  <span>CLICK HERE</span>
</div>

    <div class="bottom-guide">
      <p>THE ARCHIVE IS WAITING</p>
      <span>SELECT THE HIGHLIGHTED BOOK TO ENTER</span>
    </div>

<div class="transition-cover" id="transitionCover"></div>
  </div>
</main>

<style>
  * {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    min-height: 100%;
    background: #17110d;
  }

  body {
    overflow: hidden;
  }

  .entrance {
    width: 100%;
    height: 100vh;
    min-height: 500px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: #17110d;
  }

  .scene {
    position: relative;
    width: min(100vw, 1216px);
    aspect-ratio: 1216 / 832;
    overflow: hidden;
    background: #30251b;
  }

  .library-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  img {
  -webkit-user-drag: none;
  user-select: none;
  -webkit-user-select: none;
}

/* 가장자리에서 중앙으로 흘러드는 반짝임 */
.edge-shimmer {
  position: absolute;
  inset: 0;
  z-index: 1;
  overflow: hidden;
  pointer-events: none;
}

.edge-shimmer::before,
.edge-shimmer::after {
  content: "";
  position: absolute;
  inset: -15%;
  background-image:
    radial-gradient(circle, rgba(255, 239, 195, 1) 0 1px, transparent 2.5px),
    radial-gradient(circle, rgba(255, 211, 137, 0.9) 0 1.5px, transparent 3px),
    radial-gradient(circle, rgba(255, 245, 215, 0.85) 0 1px, transparent 2px);
  background-size:
    67px 83px,
    113px 127px,
    157px 149px;
  background-position:
    0 0,
    35px 50px,
    80px 20px;

  mask-image: radial-gradient(
    ellipse at center,
    transparent 25%,
    rgba(0, 0, 0, 0.4) 55%,
    black 100%
  );

  filter: drop-shadow(0 0 5px rgba(255, 205, 125, 0.8));
  animation: edgeParticles 7s linear infinite;
}

.edge-shimmer::after {
  background-position:
    30px 40px,
    90px 10px,
    15px 100px;
  animation-duration: 10s;
  animation-direction: reverse;
  opacity: 0.7;
}

@keyframes edgeParticles {
  0% {
    transform: translate(3%, 3%) scale(1.05);
    opacity: 0.2;
  }

  50% {
    opacity: 0.9;
  }

  100% {
    transform: translate(-3%, -3%) scale(0.96);
    opacity: 0.3;
  }
}

.top-title {
  display: block;
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 90%;
  text-align: center;
  color: #f5ead5;
  pointer-events: none;
  z-index: 6;
  isolation: isolate;
}

/* 타이틀 뒤로 퍼지는 금빛 오오라 */
.top-title::before {
  content: "";
  position: absolute;
  z-index: -1;
  left: 50%;
  top: 50%;
  width: 120%;
  height: 260%;
  transform: translate(-50%, -50%);
  background: radial-gradient(
    ellipse,
    rgba(255, 205, 125, 0.24) 0%,
    rgba(255, 185, 95, 0.13) 35%,
    rgba(255, 170, 75, 0.06) 58%,
    transparent 75%
  );
  filter: blur(22px);
  animation: titleGlow 4s ease-in-out infinite;
}

@keyframes titleGlow {
  0%, 100% {
    opacity: 0.65;
    transform: translate(-50%, -50%) scale(0.92);
  }

  50% {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1.12);
  }
}

.title-book-icon {
  display: block;
  width: clamp(44px, 5vw, 58px);
  height: auto;
  margin: 0 auto 16px;
  color: #ffe3ad;

  filter:
    drop-shadow(0 0 5px rgba(255, 235, 185, 1))
    drop-shadow(0 0 12px rgba(255, 205, 125, 0.95))
    drop-shadow(0 0 24px rgba(255, 180, 85, 0.75))
    drop-shadow(0 0 38px rgba(255, 170, 70, 0.45));
}

.top-title h1 {
  margin: 0;
  font-family: Georgia, serif;
  font-size: clamp(22px, 3.5vw, 42px);
  letter-spacing: 0.13em;
  font-weight: 500;
  color: #fff0d5;

  text-shadow:
    0 2px 3px rgba(20, 10, 4, 1),
    0 3px 8px rgba(20, 10, 4, 0.95),
    0 0 8px rgba(255, 220, 160, 0.8),
    0 0 18px rgba(255, 195, 110, 0.65),
    0 0 32px rgba(255, 175, 75, 0.4);
}

.top-title span {
  display: block;
  margin-top: 14px;
  font-family: Georgia, serif;
  font-size: clamp(9px, 1vw, 12px);
  letter-spacing: 0.28em;
  color: #fff0d5;

  text-shadow:
    0 2px 4px rgba(15, 8, 3, 1),
    0 0 8px rgba(255, 220, 155, 0.8),
    0 0 16px rgba(255, 190, 100, 0.55);
}

  /* 클릭할 책의 위치 */
.highlight-book {
  position: absolute;
  left: 67.7%;
  top: 2%;
  width: 9.5%;
  height: 21%;
  padding: 0;
  border: 0;
  background: transparent;
  cursor: pointer;

  clip-path: polygon(
    0% 16%,
    100% 25%,
    73% 100%,
    56% 100%
  );

  transform: none;
  z-index: 3;
}


.book-outline {
  position: absolute;
  left: 67.7%;
  top: 2%;
  width: 9.5%;
  height: 21%;
  overflow: visible;
  pointer-events: none;
  z-index: 4;
  opacity: 0.8;

  filter:
    drop-shadow(0 0 8px rgba(255, 220, 150, 0.55))
    drop-shadow(0 0 18px rgba(255, 195, 105, 0.45))
    drop-shadow(0 0 32px rgba(255, 175, 75, 0.3));

  animation: bookAura 3s ease-in-out infinite;
  transition: filter 0.5s ease;
}

.book-outline path {
  fill: rgba(255, 205, 125, 0.035);
  stroke: rgba(255, 220, 155, 0.08);
  stroke-width: 1;
  stroke-linecap: round;
  stroke-linejoin: round;
  vector-effect: non-scaling-stroke;
}


@keyframes bookAura {
  0%, 100% {
    opacity: 0.8;
    filter:
      drop-shadow(0 0 10px rgba(255, 225, 155, 0.65))
      drop-shadow(0 0 22px rgba(255, 200, 110, 0.55))
      drop-shadow(0 0 38px rgba(255, 180, 80, 0.4))
      drop-shadow(0 0 55px rgba(255, 165, 65, 0.25));
  }

  50% {
    opacity: 1;
    filter:
      drop-shadow(0 0 16px rgba(255, 240, 190, 0.85))
      drop-shadow(0 0 32px rgba(255, 215, 140, 0.75))
      drop-shadow(0 0 52px rgba(255, 190, 100, 0.6))
      drop-shadow(0 0 75px rgba(255, 170, 75, 0.4));
  }
}

.highlight-book:hover + .book-outline {
  filter:
    drop-shadow(0 0 14px rgba(255, 240, 195, 0.75))
    drop-shadow(0 0 30px rgba(255, 210, 130, 0.65))
    drop-shadow(0 0 48px rgba(255, 180, 80, 0.5));
}


/* 책 외곽 모양을 따라 퍼지는 금빛 파동 */
.book-ripple {
  position: absolute;
  left: 67.7%;
  top: 2%;
  width: 9.5%;
  height: 21%;
  overflow: visible;
  pointer-events: none;
  z-index: 2;
}

.book-ripple path {
  fill: none;
  stroke: rgba(255, 215, 145, 0.8);
  stroke-width: 2;
  stroke-linecap: round;
  stroke-linejoin: round;
  vector-effect: non-scaling-stroke;

  filter:
    drop-shadow(0 0 5px rgba(255, 220, 150, 0.9))
    drop-shadow(0 0 12px rgba(255, 190, 100, 0.7))
    drop-shadow(0 0 22px rgba(255, 175, 75, 0.45));

  transform-box: fill-box;
  transform-origin: center;
  animation: rippleExpand 3s ease-out infinite;
}

.book-ripple path {
  animation-delay: 0s;
}

@keyframes rippleExpand {
  0% {
    transform: scale(1);
    opacity: 0;
  }

  12% {
    opacity: 0.85;
  }

  65% {
    opacity: 0.4;
  }

  100% {
    transform: scale(1.8);
    opacity: 0;
  }
}

/* 책을 가리키는 작은 안내 문구 */
.book-hint {
  position: absolute;
  left: 78.5%;
  top: 11%;
  display: flex;
  align-items: center;
  gap: 5px;
  z-index: 4;
  pointer-events: none;

  color: #f0d39c;
  font-family: Georgia, serif;
  font-size: clamp(7px, 0.75vw, 9px);
  letter-spacing: 0.16em;
  white-space: nowrap;

  text-shadow:
    0 1px 3px rgba(20, 10, 4, 0.95),
    0 0 8px rgba(255, 205, 125, 0.75);

  animation: hintFloat 2.5s ease-in-out infinite;
}

.hint-arrow {
  width: 14px;
  height: 8px;
  overflow: visible;
  filter: drop-shadow(0 0 3px rgba(255, 210, 135, 0.7));
}

@keyframes hintFloat {
  0%, 100% {
    opacity: 0.65;
    transform: translateX(0);
  }

  50% {
    opacity: 1;
    transform: translateX(3px);
  }
}

  .bottom-guide p {
    margin: 0 0 7px;
    font-size: clamp(8px, 1vw, 11px);
    letter-spacing: 0.25em;
  }

  .bottom-guide span {
    font-size: clamp(6px, 0.8vw, 9px);
    letter-spacing: 0.16em;
  }

.transition-cover {
  position: fixed;
  inset: 0;
  z-index: 5;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #21170f;
  color: #e6cf9e;
  font-family: Georgia, serif;
  letter-spacing: 0.3em;
  font-size: 12px;
  opacity: 0;
  pointer-events: none;
  transition: opacity 1.5s ease-in-out;
}

  .transition-cover.visible {
    opacity: 1;
  }

  .scene.opening .highlight-book {
    animation: bookOpen 0.8s ease forwards;
    pointer-events: none;
  }

  @keyframes bookOpen {
    to {
      transform: rotate(-29deg) translateY(-28px) scale(1.35);
      filter: brightness(1.8);
    }
  }

  @media (max-width: 600px) {
.top-title {
  top: 50%;
}

    .bottom-guide {
      bottom: 2.5%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .book-glow {
      animation: none;
    }
  }
  .scene.opening .top-title {
  animation: titleFadeOut 0.6s ease-in-out 1s forwards;
}

@keyframes titleFadeOut {
  from {
    opacity: 1;
  }

  to {
    opacity: 0;
  }
}
.entrance {
  position: relative;
  isolation: isolate;
}

.blurred-background {
  position: absolute;
  inset: 0;
  overflow: hidden;
  pointer-events: none;
  z-index: 0;
}

.blurred-background img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  filter: blur(25px) brightness(0.55);
  transform: scale(1.12);
}

.scene {
  z-index: 1;
  box-shadow: 0 0 60px rgba(0, 0, 0, 0.3);
}
</style>

<script>
  document.addEventListener("contextmenu", (event) => {
    if (event.target instanceof HTMLImageElement) {
      event.preventDefault();
    }
  });

  document.addEventListener("dragstart", (event) => {
    if (event.target instanceof HTMLImageElement) {
      event.preventDefault();
    }
  });
</script>

<script>
  import { navigate } from "astro:transitions/client";

  document.addEventListener("click", (event) => {
    if (!(event.target instanceof Element)) return;
    if (!event.target.closest("#archiveBook")) return;

    const scene = document.querySelector(".scene");
    const cover = document.querySelector("#transitionCover");

    const bookSound =
      document.querySelector<HTMLAudioElement>("#site-book-sound");

    if (scene?.classList.contains("opening")) return;

    // 책장 넘김 효과음
    if (bookSound) {
      bookSound.volume = 0.4;
      bookSound.currentTime = 0;
      bookSound.play().catch(() => {});
    }

    // 기존 입장 애니메이션
    scene?.classList.add("opening");
    cover?.classList.add("visible");

    window.setTimeout(() => {
      navigate(
        `${import.meta.env.BASE_URL.replace(/\/$/, "")}/archive/`
      );
    }, 1600);
  });
</script>